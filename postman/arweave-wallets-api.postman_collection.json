                  "id": "1c023ab6-b065-43e9-b081-2febd325fbcc",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "text/plain"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/wallet/:address/balance",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "wallet",
                        ":address",
                        "balance"
                      ],
                      "variable": [
                        {
                          "id": "db19fbd7-090d-4203-b32d-e0d0e5fe4f7b",
                          "key": "address",
                          "value": "<string>",
                          "description": "(Required) Wallet address (Base64URL encoded SHA-256 of RSA public key modulus)"
                        }
                      ]
                    },
                    "description": "Retrieve the AR balance of a wallet address in winstons. Unknown addresses return 0. Convert to AR by dividing by 10^12.\n"
                  },
                  "response": [
