        {
          "name": "Upload a data chunk",
          "id": "2aa7207b-9c7a-4f0b-b389-e3f661c3b9ab",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data_root\": \"<string>\",\n  \"data_size\": \"<string>\",\n  \"data_path\": \"<string>\",\n  \"chunk\": \"<string>\",\n  \"offset\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/chunk",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chunk"
              ]
            },
            "description": "Upload a single data chunk for a v2 transaction. Chunks must be uploaded after the transaction header is submitted via POST /tx. Maximum chunk size is 256 KiB. The data_root from the transaction must be registered (transaction submitted) before chunks can be uploaded.\n"
          },
