    "_postman_id": "ff5e5dbb-7dae-4710-b3af-6564cb8ab7fe",
    "name": "Arweave HTTP Node Chunks API",
    "description": "The core Arweave node REST API for submitting and retrieving transactions, uploading data chunks, querying wallet balances, fetching blocks, and inspecting network state. Requests target any Arweave node on port 1984 (default gateway arweave.net). Amounts are denominated in winstons (1 AR = 10^12 winstons).\n\n\nContact Support:\n Name: Arweave Team\n Email: team@arweave.org",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:04:59.000Z",
    "updatedAt": "2026-07-28T01:04:59.000Z",
    "lastUpdatedBy": "35240",
