          "name": "Get wallet balance",
          "request": {
            "name": "Get wallet balance",
            "description": {
              "content": "Retrieve the AR balance of a wallet address in winstons. Unknown addresses return 0. Convert to AR by dividing by 10^12.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wallet",
                ":address",
                "balance"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "address",
                  "description": "(Required) Wallet address (Base64URL encoded SHA-256 of RSA public key modulus)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
            "auth": null
