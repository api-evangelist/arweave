        {
          "id": "4e6863b6-2c08-4b06-b43a-92c242cc84ba",
          "name": "Download a data chunk",
          "request": {
            "name": "Download a data chunk",
            "description": {
              "content": "Download a data chunk at the specified weave byte offset. Returns the chunk data along with its offset and size metadata.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "chunk",
                ":offset"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "offset",
                  "description": "(Required) Byte offset of the chunk within the weave"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
