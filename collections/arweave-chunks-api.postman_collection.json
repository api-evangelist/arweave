      "id": "bd604395-6e52-451c-9592-b9655d18b745",
      "name": "Chunks",
      "description": {
        "content": "Endpoints for uploading and downloading data chunks",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "01721acc-dd40-4bdc-af65-cc6d007f0617",
          "name": "Upload a data chunk",
          "request": {
            "name": "Upload a data chunk",
            "description": {
              "content": "Upload a single data chunk for a v2 transaction. Chunks must be uploaded after the transaction header is submitted via POST /tx. Maximum chunk size is 256 KiB. The data_root from the transaction must be registered (transaction submitted) before chunks can be uploaded.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "chunk"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data_root\": \"<string>\",\n  \"data_size\": \"<string>\",\n  \"data_path\": \"<string>\",\n  \"chunk\": \"<string>\",\n  \"offset\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "431d12ff-6c6b-4506-9383-245105635c9e",
              "name": "Chunk accepted",
              "originalRequest": {
